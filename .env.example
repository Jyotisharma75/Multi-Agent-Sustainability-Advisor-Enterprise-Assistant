# Copy to .env for local development. Never commit a filled in .env.
# Configuration values themselves live in configs/*.yaml; any of them can be
# overridden with SA_<SECTION>__<KEY>=<value> (JSON values are parsed).

# Selects configs/<SA_ENV>.yaml on top of configs/base.yaml
SA_ENV=development
# SA_CONFIG_DIR=configs

# API keys accepted in the X-API-Key header (comma separated, for rotation)
SA_API_KEYS=

# Azure SQL (production). Entra ID auth by default: no password needed.
AZURE_SQL_SERVER=
AZURE_SQL_DATABASE=
# Optional: client id of the user assigned managed identity used by the read
# only engine that executes model generated SQL (least privilege)
AZURE_SQL_QUERY_IDENTITY_CLIENT_ID=
# Only when database.azure_sql.auth_mode is sql_password
AZURE_SQL_USERNAME=
AZURE_SQL_PASSWORD=

# Azure OpenAI (chat and embeddings)
AZURE_OPENAI_ENDPOINT=
# Only when llm.azure_openai.auth_mode is api_key
AZURE_OPENAI_API_KEY=

# Azure AI Search
AZURE_SEARCH_ENDPOINT=
# Only when retrieval.azure_search.auth_mode is api_key
AZURE_SEARCH_API_KEY=

# Hugging Face cache location and offline switch for the local model
# HF_HOME=
# HF_HUB_OFFLINE=1

# Example overrides
# SA_LOGGING__LEVEL=DEBUG
# SA_ROUTING__LOCAL_MAX_COMPLEXITY=0.3
# SA_LLM__LOCAL__MODEL_ID=Qwen/Qwen2.5-Coder-1.5B-Instruct
